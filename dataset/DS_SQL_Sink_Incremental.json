{
	"name": "DS_SQL_Sink",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_AzureDataLake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_source": {
				"type": "string"
			},
			"p_table": {
				"type": "string"
			},
			"p_file": {
				"type": "string"
			},
			"p_load_type": {
				"type": "string"
			}
		},
		"folder": {
			"name": "A) Country Data"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@{dataset().p_source}/@{dataset().p_load_type}/@{dataset().p_table}",
					"type": "Expression"
				},
				"fileSystem": "gpt-bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}