						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_schema": "dbo2",
							"p_table": "etl_metadata"
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"folder": {
			"name": "Country Data"
		},
		"annotations": []
	}
}