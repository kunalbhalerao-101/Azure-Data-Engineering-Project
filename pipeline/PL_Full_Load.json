{
	"name": "PL_Full_Load",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    table_id,\n    source_schema,\n    source_table,\n    load_type,\n    incremental_column,\n    target_table,\n    source_type\nFROM dbo2.etl_metadata\nWHERE is_active = 1;",
