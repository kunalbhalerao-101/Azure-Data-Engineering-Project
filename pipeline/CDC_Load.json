{
	"name": "CDC_Load",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    table_id,\n    source_schema,\n    source_table,\n    load_type,\n    incremental_column,\n    target_table,\n    source_type\nFROM dbo2.etl_metadata\nWHERE is_active = 1\n  AND load_type = 'INCREMENTAL';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_schema": "do2",
							"p_table": "etl_metadata"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Tables').output.value",
						"type": "Expression"
					},
					"batchCount": 4,
					"activities": [
						{
							"name": "Current_Max_LSN",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Last_CDC_LSN",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat(\n    'SELECT CONVERT(VARCHAR(20), sys.fn_cdc_get_max_lsn(), 2) AS CurrentMaxLSN'\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_Source",
									"type": "DatasetReference",
									"parameters": {
										"p_schema": "dbo2",
										"p_table": "etl_cdc_control"
									}
								}
							}
						},
						{
							"name": "Last_CDC_LSN",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat(\n    'SELECT ',\n    'CONVERT(VARCHAR(20), last_processed_lsn, 2) AS last_processed_lsn, ',\n    'capture_instance ',\n    'FROM dbo2.etl_cdc_control ',\n    'WHERE table_id = ',\n    string(item().table_id)\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_Source",
									"type": "DatasetReference",
									"parameters": {
										"p_schema": "dbo2",
										"p_table": "etl_cdc_control"
									}
								}
							}
						},
						{
							"name": "If_CDC_Changes",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Current_Max_LSN",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(\n    activity('Current_Max_LSN').output.firstRow.CurrentMaxLSN,\n    activity('Last_CDC_LSN').output.firstRow.last_processed_lsn\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Log_CDC_No_Data",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_Audit_Success]",
											"storedProcedureParameters": {
												"new_watermark": {
													"value": {
														"value": "@activity('Last_CDC_LSN').output.firstRow.last_processed_lsn",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"pipeline_run_id": {
													"value": "@pipeline().RunId",
													"type": "String"
												},
												"rows_copied": {
													"value": "0",
													"type": "Int64"
												},
												"table_id": {
													"value": "@item().table_id",
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "No File Created",
										"type": "Delete",
										"state": "Inactive",
										"onInactiveMarkAs": "Succeeded",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_SQL_Sink",
												"type": "DatasetReference",
												"parameters": {
													"p_source": {
														"value": "@item().source_type",
														"type": "Expression"
													},
													"p_table": {
														"value": "@item().target_table",
														"type": "Expression"
													},
													"p_file": {
														"value": "@concat(\n    item().source_table,\n    '_',\n    formatDateTime(variables('Current'),'yyyy-MM-dd | HH:mm:ss'),\n    '.csv'\n)",
														"type": "Expression"
													},
													"p_load_type": "Incremental"
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy_CDC",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat(\n    'SELECT * FROM cdc.',\n    activity('Last_CDC_LSN').output.firstRow.capture_instance,\n    '_CT WHERE __$start_lsn > CONVERT(binary(10), ''',\n    activity('Last_CDC_LSN').output.firstRow.last_processed_lsn,\n    ''', 2) AND __$start_lsn <= CONVERT(binary(10), ''',\n    activity('Current_Max_LSN').output.firstRow.CurrentMaxLSN,\n    ''', 2)'\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_Source",
												"type": "DatasetReference",
												"parameters": {
													"p_schema": "cdc",
													"p_table": {
														"value": "@concat(\n    activity('Last_CDC_LSN').output.firstRow.capture_instance,\n    '_CT'\n)",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_SQL_Sink",
												"type": "DatasetReference",
												"parameters": {
													"p_source": "@item().source_type",
													"p_table": "@item().target_table",
													"p_file": {
														"value": "@concat(\n    item().source_table,\n    '_CDC_',\n    formatDateTime(utcnow(),'yyyy-MM-dd | HH:mm:ss'),\n    '.csv'\n)",
														"type": "Expression"
													},
													"p_load_type": "Incremetal"
												}
											}
										]
									},
									{
										"name": "Update_CDC_Control",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_CDC",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_CDC_Control]",
											"storedProcedureParameters": {
												"new_processed_lsn": {
													"value": {
														"value": "@activity('Current_Max_LSN').output.firstRow.CurrentMaxLSN",
														"type": "Expression"
													},
													"type": "Byte[]"
												},
												"table_id": {
													"value": "@item().table_id",
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "Log_CDC_Failure",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_CDC",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_Audit_Failure]",
											"storedProcedureParameters": {
												"error_message": {
													"value": {
														"value": "@activity('Copy_CDC').error.message",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"table_id": {
													"value": {
														"value": "@item().table_id",
														"type": "Expression"
													},
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"variables": {
			"Current": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Country Data"
		},
		"annotations": []
	}
}