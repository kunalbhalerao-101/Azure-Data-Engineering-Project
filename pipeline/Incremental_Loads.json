{
	"name": "Incremental_Loads",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    table_id,\n    source_schema,\n    source_table,\n    load_type,\n    incremental_column,\n    target_table,\n    source_type\nFROM dbo2.etl_metadata\nWHERE is_active = 1\n  AND load_type = 'INCREMENTAL';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_schema": "do2",
							"p_table": "etl_metadata"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Tables').output.value",
						"type": "Expression"
					},
					"batchCount": 4,
					"activities": [
						{
							"name": "Last_Watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat(\n    'SELECT last_watermark\n    FROM dbo2.etl_watermark\n    WHERE table_id = ',\n    string(item().table_id)\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_Source",
									"type": "DatasetReference",
									"parameters": {
										"p_schema": "dbo2",
										"p_table": "etl_metadata"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "New_Watermark",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Last_Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat(\n    'SELECT MAX([',\n    item().incremental_column,\n    ']) AS new_watermark FROM [',\n    item().source_schema,\n    '].[',\n    item().source_table,\n    ']'\n)\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_Source",
									"type": "DatasetReference",
									"parameters": {
										"p_schema": {
											"value": "@item().source_schema",
											"type": "Expression"
										},
										"p_table": {
											"value": "@item().source_table",
											"type": "Expression"
										}
									}
								}
							}
						},
						{
							"name": "If_New_Data",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Log_Audit_Start",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(\n    ticks(activity('New_Watermark').output.firstRow.new_watermark),\n    ticks(activity('Last_Watermark').output.firstRow.last_watermark)\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Log_No_Data",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_Audit_Success]",
											"storedProcedureParameters": {
												"new_watermark": {
													"value": {
														"value": "@activity('Last_Watermark').output.firstRow.last_watermark",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"pipeline_run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"rows_copied": {
													"value": "0",
													"type": "Int64"
												},
												"table_id": {
													"value": {
														"value": "@item().table_id",
														"type": "Expression"
													},
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "No Files Created",
										"type": "Delete",
										"state": "Inactive",
										"onInactiveMarkAs": "Succeeded",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_SQL_Sink_Incremental",
												"type": "DatasetReference",
												"parameters": {
													"p_source": {
														"value": "@item().source_type",
														"type": "Expression"
													},
													"p_table": {
														"value": "@item().target_table",
														"type": "Expression"
													},
													"p_file": {
														"value": "@concat(\n    item().source_table,\n    '_',\n    formatDateTime(variables('Current'),'yyyy-MM-dd | HH:mm:ss'),\n    '.csv'\n)",
														"type": "Expression"
													},
													"p_load_type": "Incremental"
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy Incremental Data",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat(\n    'SELECT * FROM [',\n    item().source_schema,\n    '].[',\n    item().source_table,\n    '] WHERE [',\n    item().incremental_column,\n    '] > ''',\n    string(activity('Last_Watermark').output.firstRow.last_watermark),\n    ''' AND [',\n    item().incremental_column,\n    '] <= ''',\n    string(activity('New_Watermark').output.firstRow.new_watermark),\n    ''''\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_Source",
												"type": "DatasetReference",
												"parameters": {
													"p_schema": {
														"value": "@item().source_schema",
														"type": "Expression"
													},
													"p_table": {
														"value": "@item().source_table",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_SQL_Sink_Incremental",
												"type": "DatasetReference",
												"parameters": {
													"p_source": "@item().source_type",
													"p_table": "@item().target_table",
													"p_file": {
														"value": "@concat(\n    item().source_table,\n    '_',\n    formatDateTime(utcNow(),'yyyy-MM-dd | HH:mm:ss'),\n    '.csv'\n)",
														"type": "Expression"
													},
													"p_load_type": "Incremental"
												}
											}
										]
									},
									{
										"name": "Current",
										"type": "SetVariable",
										"state": "Inactive",
										"onInactiveMarkAs": "Succeeded",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "Current",
											"value": {
												"value": "@convertTimeZone(utcNow(),'UTC','India Standard Time')",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Update_Watermark",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy Incremental Data",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_Watermark]",
											"storedProcedureParameters": {
												"new_watermark": {
													"value": "@activity('New_Watermark').output.firstRow.new_watermark",
													"type": "String"
												},
												"table_id": {
													"value": "@item().table_id",
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "Log_Incremental_Success",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Update_Watermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_Audit_Success]",
											"storedProcedureParameters": {
												"new_watermark": {
													"value": {
														"value": "@activity('New_Watermark').output.firstRow.new_watermark",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"pipeline_run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"rows_copied": {
													"value": {
														"value": "@activity('Copy Incremental Data').output.rowsCopied",
														"type": "Expression"
													},
													"type": "Int64"
												},
												"table_id": {
													"value": {
														"value": "@item().table_id",
														"type": "Expression"
													},
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "Log_Incremental_Failure",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy Incremental Data",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo2].[usp_Update_Audit_Failure]",
											"storedProcedureParameters": {
												"error_message": {
													"value": {
														"value": "@activity('Copy Incremental Data').error.message",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"table_id": {
													"value": {
														"value": "@item().table_id",
														"type": "Expression"
													},
													"type": "Int32"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSqlDB",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						},
						{
							"name": "Log_Audit_Start",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "New_Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo2].[usp_Insert_Audit_Start]",
								"storedProcedureParameters": {
									"last_watermark": {
										"value": {
											"value": "@activity('Last_Watermark').output.firstRow.last_watermark",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"load_type": {
										"value": {
											"value": "@item().load_type",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_name": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"source_schema": {
										"value": {
											"value": "@item().source_schema",
											"type": "Expression"
										},
										"type": "String"
									},
									"source_table": {
										"value": {
											"value": "@item().source_table",
											"type": "Expression"
										},
										"type": "String"
									},
									"table_id": {
										"value": {
											"value": "@item().table_id",
											"type": "Expression"
										},
										"type": "Int32"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDB",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"variables": {
			"Current": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Country Data"
		},
		"annotations": []
	}
}